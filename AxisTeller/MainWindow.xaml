<Window x:Class="AxisTeller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AxisTeller"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="终末地轴提示器" Icon="/Assets/app.ico"
        Width="1220" Height="820" MinWidth="1040" MinHeight="660"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:IndexPlusOneConverter x:Key="Idx" />
        <conv:TwoDigitConverter x:Key="TwoDigit" />
        <conv:FirstCharConverter x:Key="FirstChar" />
        <conv:EmptyToCollapsedConverter x:Key="EmptyCollapsed" />
        <conv:NullToCollapsedConverter x:Key="NullCollapsed" />
        <conv:NullToVisibleConverter x:Key="NullVisible" />

        <Style x:Key="StepOperatorButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Ink}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="{StaticResource BgPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="30" Height="30" Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="1">
                        <TextBlock Text="轴" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="终末地 · 轴提示器" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="// ROTATION PROMPTER" Style="{StaticResource Mono}" FontSize="9" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border x:Name="SourceChip" Margin="22,0,0,0" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                            Padding="9,5" VerticalAlignment="Center" Background="{StaticResource BgPanel}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                                    BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="SourceText" Text="数据源" Style="{StaticResource Mono}" FontSize="9.5"
                                       Foreground="{StaticResource InkSoft}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource OutlineButton}"
                            Click="OpenSettings_Click" Margin="0,0,8,0" Padding="14,7" />
                    <Button x:Name="StartButton" Content="▶  开始提示" Style="{StaticResource AccentButton}"
                            Click="StartOverlay_Click" Margin="0,0,10,0" ToolTip="打开悬浮提示窗（全局热键生效）" />
                    <Border Width="1" Height="24" Background="{StaticResource BorderSoft}" Margin="0,0,8,0" />
                    <Button Content="—" Style="{StaticResource SquareIconButton}" Width="30" Height="30"
                            Click="Minimize_Click" ToolTip="最小化" />
                    <Button Content="□" Style="{StaticResource SquareIconButton}" Width="30" Height="30" Margin="6,0,0,0"
                            Click="Maximize_Click" ToolTip="最大化 / 还原" />
                    <Button Content="✕" Style="{StaticResource SquareIconButton}" Width="30" Height="30" Margin="6,0,0,0"
                            Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：轴库 -->
                <DockPanel Grid.Column="0" Background="{StaticResource BgPanel}">
                    <Grid DockPanel.Dock="Top" Margin="16,16,16,10">
                        <StackPanel>
                            <TextBlock Text="// AXIS LIBRARY" Style="{StaticResource Mono}" FontSize="9" />
                            <TextBlock Text="轴库" Style="{StaticResource SectionTitle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="+ 新建" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="AddAxis_Click" Padding="12,6" FontSize="11.5" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="复制轴" Style="{StaticResource OutlineButton}"
                                    Click="DuplicateAxis_Click" Padding="8,6" FontSize="11.5" />
                            <Button Grid.Column="2" Content="删除轴" Style="{StaticResource OutlineButton}"
                                    Foreground="{StaticResource Danger}" BorderBrush="{StaticResource Danger}"
                                    Click="DeleteAxis_Click" Padding="8,6" FontSize="11.5" />
                        </Grid>
                        <Button Content="⇅  导入 / 导出 JSON" Style="{StaticResource SubtleButton}" Margin="0,8,0,0"
                                Click="ImportExport_Click" />
                    </StackPanel>

                    <ListBox x:Name="AxisList" Background="Transparent" BorderThickness="0" AlternationCount="99"
                             SelectionChanged="AxisList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AxisNo" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource TwoDigit}}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource InkMuted}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="AxisItemName" Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="AxisItemSummary" Text="{Binding Summary}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                   Foreground="{StaticResource InkMuted}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                 Value="True">
                                        <Setter TargetName="AxisItemName" Property="Foreground" Value="{StaticResource OnInk}" />
                                        <Setter TargetName="AxisItemSummary" Property="Foreground" Value="{StaticResource OnInkMuted}" />
                                        <Setter TargetName="AxisNo" Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="1" Background="{StaticResource Ink}" />

                <!-- 右侧：编辑区 -->
                <DockPanel Grid.Column="2" Background="{StaticResource GridBrush}" Margin="16,14,16,12">
                    <!-- 轴属性 -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="// AXIS NAME　轴名" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,0,0,4" />
                                <TextBox x:Name="AxisNameBox" TextChanged="DataTextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="// TEAM　阵容" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,0,0,4" />
                                <TextBox x:Name="TeamBox" TextChanged="DataTextChanged"
                                         ToolTip="例如：陈千语 / 佩丽卡 / 骏卫 / 余烬" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="// ROUNDS　轮数" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Style="{StaticResource SquareIconButton}" Click="LoopsMinus_Click" />
                                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,1" MinWidth="42"
                                            Height="26" Margin="6,0">
                                        <TextBlock x:Name="LoopsText" Text="2" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Content="+" Style="{StaticResource SquareIconButton}" Click="LoopsPlus_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="+ 添加循环" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                                Click="AddCycle_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="循环预览" Style="{StaticResource GhostButton}" Click="PreviewCycle_Click"
                                    ToolTip="在提示窗里查看这条轴" BorderBrush="{StaticResource Ink}" />
                            <Button Content="▶  从当前轴开始提示" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                    Click="StartOverlay_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="CycleScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <ItemsControl x:Name="CycleItems" AlternationCount="99">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}"
                                            BorderThickness="1" Margin="0,0,0,12">
                                        <StackPanel>
                                            <!-- 循环头 -->
                                            <Border Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="0,0,0,1" Padding="0,0,8,0">
                                                <Grid Height="38">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="38" Height="38" Background="{StaticResource Ink}">
                                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource TwoDigit}}"
                                                                       FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Accent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="150" Margin="10,0,8,0" TextChanged="DataTextChanged"
                                                                 ToolTip="循环名称，例如：起手 / 常规 / 收尾" />
                                                        <TextBox Text="{Binding RepeatHint, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="270" TextChanged="DataTextChanged"
                                                                 ToolTip="循环备注，例如：留战技给下一轮 / 卡 CD" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Steps.Count, StringFormat={}{0:00} STEPS}"
                                                                   Style="{StaticResource Mono}" FontSize="9" Margin="0,0,10,0" />
                                                        <Button Content="↑" Style="{StaticResource IconButton}" Width="24" Height="24" Click="CycleUp_Click" ToolTip="上移循环" />
                                                        <Button Content="↓" Style="{StaticResource IconButton}" Width="24" Height="24" Click="CycleDown_Click" ToolTip="下移循环" />
                                                        <Button Content="⧉" Style="{StaticResource IconButton}" Width="24" Height="24" Click="CycleDuplicate_Click" ToolTip="复制循环" />
                                                        <Button Content="✕" Style="{StaticResource DangerIconButton}" Width="24" Height="24" Click="CycleDelete_Click" ToolTip="删除循环" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 动作列表 -->
                                            <ItemsControl ItemsSource="{Binding Steps}" AlternationCount="99">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="8,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30" />
                                                                    <ColumnDefinition Width="206" />
                                                                    <ColumnDefinition Width="122" />
                                                                    <ColumnDefinition Width="74" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource TwoDigit}}"
                                                                           Style="{StaticResource Mono}" FontSize="10" />

                                                                <Button Grid.Column="1" Style="{StaticResource StepOperatorButton}"
                                                                        AutomationProperties.Name="{Binding DisplayName}"
                                                                        Click="PickOperator_Click" ToolTip="点击更换干员">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="42" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid Grid.Column="0" Width="34" Height="34" HorizontalAlignment="Left">
                                                                            <Border Background="{StaticResource BgPanelAlt}"
                                                                                    BorderBrush="{StaticResource Ink}" BorderThickness="1" />
                                                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstChar}}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                                                                                       Visibility="{Binding Avatar, Converter={StaticResource NullVisible}}" />
                                                                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="1"
                                                                                    Visibility="{Binding Avatar, Converter={StaticResource NullCollapsed}}">
                                                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                                                            </Border>
                                                                            <Border Width="3" HorizontalAlignment="Left" Background="{Binding Accent}" />
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="8,0,0,0"
                                                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                </Button>

                                                                <Grid Grid.Column="2" Margin="0,0,10,0">
                                                                    <TextBox Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextChanged="DataTextChanged" Padding="8,5,24,5" />
                                                                    <Button Content="▾" Style="{StaticResource TinyButton}"
                                                                            HorizontalAlignment="Right" Margin="0,2,2,2"
                                                                            Click="ActionMenu_Click" ToolTip="常用动作" />
                                                                </Grid>

                                                                <Button Grid.Column="3" Content="{Binding KindLabel}"
                                                                        Style="{StaticResource TinyButton}" Margin="0,0,10,0"
                                                                        FontSize="10.5" BorderBrush="{StaticResource BorderSoft}"
                                                                        BorderThickness="1" Padding="4,0" Height="26"
                                                                        Click="KindMenu_Click"
                                                                        ToolTip="动作类型：开启自动检测后，识别到这个类型的操作才算完成本步" />

                                                                <TextBox Grid.Column="4" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextChanged="DataTextChanged" Margin="0,0,10,0"
                                                                         ToolTip="备注，例如：等 CD / 留终结技 / 面向调整" />

                                                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                                    <Button Content="↑" Style="{StaticResource IconButton}" Width="24" Height="24" Click="StepUp_Click" ToolTip="上移" />
                                                                    <Button Content="↓" Style="{StaticResource IconButton}" Width="24" Height="24" Click="StepDown_Click" ToolTip="下移" />
                                                                    <Button Content="✕" Style="{StaticResource DangerIconButton}" Width="24" Height="24" Click="StepDelete_Click" ToolTip="删除动作" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="+ 添加动作" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                    Margin="10,6,0,4" Click="AddStep_Click" FontSize="11.5" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Grid Grid.Row="2" Background="{StaticResource Ink}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="7" Height="7" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource Mono}" FontSize="10"
                               Foreground="{StaticResource OnInk}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Mono}" FontSize="9.5"
                           Foreground="{StaticResource OnInkMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
