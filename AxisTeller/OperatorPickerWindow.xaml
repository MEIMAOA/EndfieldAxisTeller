<Window x:Class="AxisTeller.OperatorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择干员" Icon="/Assets/app.ico" Width="900" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource Ink}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource BgPanel}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="1">
                        <TextBlock Text="干" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="选择干员" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="// OPERATORS" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="CountText" Text="" Style="{StaticResource Mono}" FontSize="9"
                               VerticalAlignment="Center" Margin="18,2,0,0" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource SquareIconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="// SEARCH" Style="{StaticResource Mono}" FontSize="9" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="SearchBox" Padding="10,7" TextChanged="SearchBox_TextChanged" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="14,0,10,0"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="OperatorPanel" />
            </ScrollViewer>

            <Border Grid.Row="3" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="找不到？直接输入名字" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBox x:Name="CustomNameBox" Width="190" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource OutlineButton}" Click="Cancel_Click" Margin="0,0,8,0" />
                        <Button Content="使用这个名字" Style="{StaticResource AccentButton}" Click="UseCustom_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
