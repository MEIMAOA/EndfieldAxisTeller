<Window x:Class="AxisTeller.SamplingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 采样" Width="352" Height="188"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        UseLayoutRounding="True" Foreground="{StaticResource OnInk}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="#FF0A0A0A" BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource Accent}" Width="4" Height="16" />
                    <TextBlock Text="AI 采样" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="KindText" Text="" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Accent}" />
            </Grid>

            <TextBlock x:Name="RoiText" Grid.Row="1" Style="{StaticResource Mono}" FontSize="9.5"
                       Foreground="#FF9A9A9A" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="CountText" Grid.Row="2" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" />

            <TextBlock x:Name="FeedbackText" Grid.Row="3" FontSize="11.5" Foreground="{StaticResource Accent}"
                       TextWrapping="Wrap" Margin="0,6,0,0" VerticalAlignment="Top" />

            <Grid Grid.Row="4" Margin="0,6,0,0">
                <TextBlock x:Name="HintText" Style="{StaticResource Mono}" FontSize="9" Foreground="#FF8A8A8A"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250" />
                <Button Content="退出 (F4)" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Stop_Click" Padding="8,3" FontSize="10" Foreground="{StaticResource Ink}"
                        Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" />
            </Grid>
        </Grid>
    </Border>
</Window>
