<Window x:Class="AxisTeller.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终末地轴提示" Width="470" Height="290"
        WindowStyle="None" Background="#FF0A0A0A" Foreground="#FFFFFF"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="OverlayIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2EA00" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F2EA00" />
                                <Setter Property="Foreground" Value="#111111" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 参照游戏内「任务目标」追踪面板：半透明黑底横条 + 细线分隔 + 荧光黄强调 -->
    <StackPanel x:Name="Tracker" Background="Transparent"
                MouseLeftButtonDown="Tracker_MouseLeftButtonDown"
                MouseRightButtonUp="Tracker_MouseRightButtonUp">

        <!-- 头部：轴名 + 循环/轮次 -->
        <Border Background="#FF0A0A0A" Height="32" Padding="9,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="17" Height="17" Background="#F2EA00">
                        <TextBlock Text="▮" FontSize="9" Foreground="#111111" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AxisNameText" Text="轴" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                               Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="MetaText" Text="CYCLE 01/03" FontFamily="{StaticResource MonoFont}"
                               FontSize="9.5" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                    <Button x:Name="EditButton" Content="✎" Click="OpenEditor_Click" Width="22" Height="22"
                            Style="{StaticResource OverlayIconButton}" Margin="10,0,0,0" ToolTip="打开编辑窗口" />
                    <Button x:Name="HideButton" Content="✕" Click="CloseOverlay_Click" Width="22" Height="22"
                            Style="{StaticResource OverlayIconButton}" Margin="4,0,0,0" ToolTip="关闭提示窗" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Height="1" Background="#38FFFFFF" />

        <!-- 本轮进度 -->
        <Border Background="#FF050505" Height="24" Padding="9,0">
            <Grid>
                <Grid x:Name="ProgressTrack" Height="2" VerticalAlignment="Center" Margin="0,0,74,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressCompletedCol" Width="0*" />
                        <ColumnDefinition x:Name="ProgressRemainingCol" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F2EA00" />
                    <Border Grid.Column="1" Background="#33FFFFFF" />
                </Grid>
                <TextBlock x:Name="ProgressText" Text="00 / 00" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                           Foreground="#B3FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Height="1" Background="#38FFFFFF" />

        <!-- 当前动作 -->
        <Border x:Name="CurrentRow" Background="#FF0B0B0B" Height="92">
            <Grid>
                <Border x:Name="CurrentAccentBar" Width="3" HorizontalAlignment="Left" Background="#F2EA00" />
                <Grid Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="64" Height="64">
                        <Border Background="#1A1A1A" BorderBrush="#4DFFFFFF" BorderThickness="1" />
                        <TextBlock x:Name="AvatarLetter" Text="?" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border BorderBrush="#4DFFFFFF" BorderThickness="1">
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StepNameText" Text="干员" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StepNoteText" Text="" FontSize="10" Foreground="#8CFFFFFF"
                                       Margin="8,3,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="160" />
                        </StackPanel>
                        <TextBlock x:Name="StepActionText" Text="战技" FontSize="21" FontWeight="Bold"
                                   Foreground="#F2EA00" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock x:Name="StepIndexText" Grid.Column="2" Text="#01" FontFamily="{StaticResource MonoFont}"
                               FontSize="18" Foreground="#59FFFFFF" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Border Height="1" Background="#38FFFFFF" />

        <!-- 接下来 -->
        <Border Background="#FF050505" Height="20" Padding="9,0">
            <Grid>
                <TextBlock Text="// NEXT" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                           Foreground="#73FFFFFF" VerticalAlignment="Center" />
                <TextBlock x:Name="NextCycleHint" Text="" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                           Foreground="#73FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="UpcomingRow1" Background="#FF0F0F0F" Height="30" Padding="9,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpNo1" Grid.Column="0" Text="02" FontFamily="{StaticResource MonoFont}"
                           FontSize="9.5" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="UpAccent1" Width="2" Height="12" Background="#666666" Margin="0,0,7,0" />
                    <TextBlock x:Name="UpName1" Text="—" FontSize="11.5" Foreground="#E6FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="UpAction1" Grid.Column="2" Text="" FontSize="11" Foreground="#8CFFFFFF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Height="1" Background="#26FFFFFF" />
        <Border x:Name="UpcomingRow2" Background="#FF0F0F0F" Height="30" Padding="9,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpNo2" Grid.Column="0" Text="03" FontFamily="{StaticResource MonoFont}"
                           FontSize="9.5" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="UpAccent2" Width="2" Height="12" Background="#666666" Margin="0,0,7,0" />
                    <TextBlock x:Name="UpName2" Text="—" FontSize="11.5" Foreground="#E6FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="UpAction2" Grid.Column="2" Text="" FontSize="11" Foreground="#8CFFFFFF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Height="1" Background="#26FFFFFF" />
        <Border x:Name="UpcomingRow3" Background="#FF0F0F0F" Height="30" Padding="9,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpNo3" Grid.Column="0" Text="04" FontFamily="{StaticResource MonoFont}"
                           FontSize="9.5" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="UpAccent3" Width="2" Height="12" Background="#666666" Margin="0,0,7,0" />
                    <TextBlock x:Name="UpName3" Text="—" FontSize="11.5" Foreground="#E6FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="UpAction3" Grid.Column="2" Text="" FontSize="11" Foreground="#8CFFFFFF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Height="1" Background="#38FFFFFF" />

        <!-- 底部热键提示 -->
        <Border Background="#FF0A0A0A" Height="26" Padding="9,0">
            <Grid>
                <TextBlock x:Name="HotkeyHintText" Text="" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                           Foreground="#73FFFFFF" VerticalAlignment="Center" />
                <TextBlock x:Name="RoundText" Text="" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                           Foreground="#73FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
