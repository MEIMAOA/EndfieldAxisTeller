<Window x:Class="AxisTeller.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Icon="/Assets/app.ico" Width="800" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource Ink}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource BgPanel}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="1">
                        <TextBlock Text="设" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="设置" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="// SETTINGS" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Style="{StaticResource SquareIconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                <StackPanel Margin="22,18,22,14">

                    <!-- 按键 -->
                    <TextBlock Text="// HOTKEYS" Style="{StaticResource Mono}" FontSize="9" />
                    <TextBlock Text="按键" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                            Padding="16,14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="下一步（推进动作）" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button x:Name="NextKeyButton" Tag="NextKey" Style="{StaticResource OutlineButton}"
                                        HorizontalAlignment="Right" MinWidth="116" Click="ChooseKey_Click" Padding="8,5" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="下一个循环" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button x:Name="NextCycleKeyButton" Tag="NextCycleKey" Style="{StaticResource OutlineButton}"
                                        HorizontalAlignment="Right" MinWidth="116" Click="ChooseKey_Click" Padding="8,5" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="上一步" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button x:Name="PrevKeyButton" Tag="PrevKey" Style="{StaticResource OutlineButton}"
                                        HorizontalAlignment="Right" MinWidth="116" Click="ChooseKey_Click" Padding="8,5" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="重新开始" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button x:Name="ResetKeyButton" Tag="ResetKey" Style="{StaticResource OutlineButton}"
                                        HorizontalAlignment="Right" MinWidth="116" Click="ChooseKey_Click" Padding="8,5" />
                            </Grid>
                            <Grid Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="显示 / 隐藏提示窗" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button x:Name="ToggleKeyButton" Tag="ToggleOverlayKey" Style="{StaticResource OutlineButton}"
                                        HorizontalAlignment="Right" MinWidth="116" Click="ChooseKey_Click" Padding="8,5" />
                            </Grid>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="全局生效，游戏窗口在前台也能按。"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- 播放 -->
                    <TextBlock Text="// PLAYBACK" Style="{StaticResource Mono}" FontSize="9" Margin="0,22,0,0" />
                    <TextBlock Text="播放" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                            Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox x:Name="LoopInfiniteCheck" Content="走完所有轮数后继续从头循环（无限循环）"
                                      Click="LoopInfinite_Click" />
                            <CheckBox x:Name="TopmostCheck" Content="提示窗永远置顶" Margin="0,14,0,0"
                                      Click="Topmost_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 森空岛 -->
                    <TextBlock Text="// SKLAND DATA" Style="{StaticResource Mono}" FontSize="9" Margin="0,22,0,0" />
                    <TextBlock Text="森空岛数据" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                            Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ServerCnButton" Tag="cn" Content="国服 · 森空岛" Style="{StaticResource OutlineButton}"
                                        Click="Server_Click" Padding="12,6" FontSize="11.5" />
                                <Button x:Name="ServerGlobalButton" Tag="global" Content="国际服 · Skport" Style="{StaticResource OutlineButton}"
                                        Margin="8,0,0,0" Click="Server_Click" Padding="12,6" FontSize="11.5" />
                                <TextBlock x:Name="UserText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="// SKLAND TOKEN" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,16,0,5" />
                            <TextBox x:Name="TokenBox" Height="32" ToolTip="在森空岛 App 里复制的 token，或整段 JSON 都可以" />
                            <TextBlock Text="token 只保存在本机存档里，不会上传到任何服务器。获取方式见项目 README。"
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="SyncButton" Content="⇩  从森空岛同步角色" Style="{StaticResource AccentButton}"
                                        Click="Sync_Click" />
                                <TextBlock x:Name="SyncStatus" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="440" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <TextBlock Text="// ABOUT" Style="{StaticResource Mono}" FontSize="9" Margin="0,22,0,0" />
                    <TextBlock Text="关于与数据" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                            Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="内置干员数据：终末地 34 名干员（森空岛干员图鉴数据 / 社区镜像），头像已缓存，可离线使用。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="用森空岛 token 登录后，可以同步你账号里实际拥有的干员（含头像）。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock x:Name="DataPathText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button Content="打开存档目录" Style="{StaticResource OutlineButton}" Margin="12,0,0,0"
                                        Click="OpenDataFolder_Click" Padding="10,5" FontSize="11.5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="22,0,22,0">
                    <Button Content="恢复默认按键" Style="{StaticResource TinyButton}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Click="RestoreDefaults_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource OutlineButton}" Click="Cancel_Click" Margin="0,0,8,0" />
                        <Button Content="保存" Style="{StaticResource AccentButton}" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
