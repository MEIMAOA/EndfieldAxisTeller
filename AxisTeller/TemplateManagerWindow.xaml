<Window x:Class="AxisTeller.TemplateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板管理" Icon="/Assets/app.ico" Width="1000" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource Ink}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource BgPanel}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="1">
                        <TextBlock Text="模" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="模板管理" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="// TEMPLATE MATCHING" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="CaptureStatusText" Text="" Style="{StaticResource Mono}" FontSize="9"
                               VerticalAlignment="Center" Margin="18,2,0,0" />
                    <TextBlock x:Name="FrameInfoText" Text="" Style="{StaticResource Mono}" FontSize="9"
                               VerticalAlignment="Center" Margin="12,2,0,0" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource SquareIconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Close_Click" />
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- 预览 + 选框 -->
                <Grid Grid.Column="0" Background="{StaticResource BgPanelAlt}">
                    <Grid x:Name="PreviewHost" Margin="12">
                        <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                        <Canvas x:Name="OverlayCanvas" Background="Transparent" Cursor="Cross"
                                MouseLeftButtonDown="Canvas_MouseDown"
                                MouseMove="Canvas_MouseMove"
                                MouseLeftButtonUp="Canvas_MouseUp"
                                LostMouseCapture="OverlayCanvas_LostMouseCapture" />
                        <Border x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                                Padding="14,8">
                            <TextBlock Text="正在等待画面…" Style="{StaticResource Caption}" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource Ink}" />

                <!-- 右侧操作（可滚动） -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,14">
                    <TextBlock Text="// ACTION KIND" Style="{StaticResource Mono}" FontSize="9" />
                    <TextBlock Text="动作类型（模板归属）" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <WrapPanel x:Name="KindPanel" Margin="0,8,0,0" />

                    <TextBlock Text="// ROI" Style="{StaticResource Mono}" FontSize="9" Margin="0,18,0,0" />
                    <TextBlock Text="截取识别区域" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <TextBlock x:Name="RoiHint" Text="在左侧画面上按住鼠标拖出要识别的区域（例如技能已放出时的特效/图标、连携提示）。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button x:Name="SaveButton" Content="保存为模板" Style="{StaticResource AccentButton}"
                            Click="Save_Click" Margin="0,12,0,0" IsEnabled="False" />

                    <TextBlock Text="// LIBRARY" Style="{StaticResource Mono}" FontSize="9" Margin="0,18,0,0" />
                    <TextBlock Text="已有模板" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <TextBlock x:Name="TemplateCountText" Style="{StaticResource Caption}" Margin="0,4,0,6" />
                    <ListBox x:Name="TemplatesList" Height="180" BorderBrush="{StaticResource Ink}"
                             BorderThickness="1" SelectionChanged="TemplatesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Text}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="DeleteButton" Content="删除选中模板" Style="{StaticResource OutlineButton}"
                            Foreground="{StaticResource Danger}" BorderBrush="{StaticResource Danger}"
                            Click="Delete_Click" Margin="0,10,0,0" />

                    <TextBlock Text="// SELF CHECK" Style="{StaticResource Mono}" FontSize="9" Margin="0,18,0,0" />
                    <TextBlock Text="匹配自测" Style="{StaticResource SectionTitle}" Margin="0,2,0,0" />
                    <TextBlock x:Name="MatchScoreText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Text="等待画面…" />

                    <TextBlock Text="// AI MODEL" Style="{StaticResource Mono}" FontSize="9" Margin="0,18,0,0" />
                    <TextBlock Text="AI 训练（ONNX 预训练特征 + 本地分类头）" Style="{StaticResource SectionTitle}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="AiStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Text="读取中…" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AiPosButton" Content="采集正样本" Style="{StaticResource OutlineButton}"
                                Click="AiCapturePos_Click" Padding="10,5" FontSize="11.5" />
                        <Button x:Name="AiNegButton" Content="采集负样本" Style="{StaticResource OutlineButton}"
                                Margin="8,0,0,0" Click="AiCaptureNeg_Click" Padding="10,5" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AiTrainButton" Content="训练模型" Style="{StaticResource AccentButton}"
                                Click="AiTrain_Click" Padding="12,6" FontSize="11.5" />
                        <Button x:Name="AiClearButton" Content="清除样本/模型" Style="{StaticResource OutlineButton}"
                                Margin="8,0,0,0" Click="AiClear_Click" Padding="10,5" FontSize="11.5" />
                    </StackPanel>
                    <Button x:Name="SamplingButton" Content="▶  开始采样（游戏里按 F1/F2/F3）" Style="{StaticResource AccentButton}"
                            Click="StartSampling_Click" Margin="0,8,0,0" />
                    <TextBlock Text="点「开始采样」后窗口会收起、显示一个小 HUD；切回游戏，按 F1 采正样本、F2 采负样本、F3 训练、F4 退出。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="采样：拖好区域后，在「动作出现的瞬间」点「采集正样本」，平时点「采集负样本」；正负各 10 张以上再训练。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部 -->
            <Border Grid.Row="2" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0,16,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="700" />
                    <Button Content="关闭" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
