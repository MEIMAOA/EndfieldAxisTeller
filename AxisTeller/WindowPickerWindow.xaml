<Window x:Class="AxisTeller.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择游戏窗口" Icon="/Assets/app.ico" Width="760" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource Ink}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource BgPanel}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="1">
                        <TextBlock Text="窗" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="选择游戏窗口" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="// PICK WINDOW" Style="{StaticResource Mono}" FontSize="8.5" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Style="{StaticResource SquareIconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Padding="10,7" TextChanged="SearchBox_TextChanged" />
                <Button Grid.Column="1" Content="刷新" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                        Click="Refresh_Click" Padding="12,6" />
            </Grid>

            <Border Grid.Row="2" Margin="20,0,20,0" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                    Background="{StaticResource BgPanel}">
                <ListBox x:Name="WindowList" BorderThickness="0" MouseDoubleClick="WindowList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Mono}" FontSize="9.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,0,20,0">
                    <TextBlock x:Name="HintText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="480"
                               Text="选中《终末地》窗口后点「选择」；列表里没有的话，先切到游戏窗口再点刷新。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource OutlineButton}" Click="Cancel_Click" Margin="0,0,8,0" />
                        <Button Content="选择" Style="{StaticResource AccentButton}" Click="Confirm_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
